# ==============================================================================
# TỆP MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Đề tài số 03: Website Quảng bá Sản phẩm bằng WordPress
# Môn học: Triển khai và Quản trị Hệ thống Phần mềm
#
# HƯỚNG DẪN:
# Sao chép tệp này thành .env và điền mật khẩu mạnh trước khi chạy:
#   cp .env.example .env
# TUYỆT ĐỐI KHÔNG ĐƯA TỆP .env THẬT LÊN KHO MÃ NGUỒN GITHUB!
# ==============================================================================

# 1. Cấu hình Cơ sở dữ liệu MySQL
# Mật khẩu quản trị cao nhất của MySQL (Root User)
MYSQL_ROOT_PASSWORD=ThayTheBangMatKhauRootSieuManh_123456!@#

# Tên cơ sở dữ liệu dùng riêng cho WordPress
MYSQL_DATABASE=wordpress_db

# Tài khoản chuyên biệt cho WordPress kết nối (Nguyên tắc quyền tối thiểu - Least Privilege)
MYSQL_USER=wp_app_user

# Mật khẩu tài khoản ứng dụng WordPress
MYSQL_PASSWORD=ThayTheBangMatKhauUngDungManh_654321!@#

# 2. Cấu hình WordPress
# Tiền tố các bảng dữ liệu trong CSDL (Khuyến nghị bảo mật: tránh để lộ mặc định nếu cần)
WORDPRESS_TABLE_PREFIX=wp_

# Chế độ Debug (0: Tắt trên môi trường triển khai, 1: Bật để xem lỗi khi dev)
WORDPRESS_DEBUG=0

# 3. Cấu hình phpMyAdmin
# Chống kết nối tới các máy chủ CSDL tùy tiện bên ngoài (0: Vô hiệu hóa tính năng kết nối tự do)
PMA_ARBITRARY=0
